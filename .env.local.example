# Copy to .env.local and add your key to enable live AI generation.
# Without a key, HerNext runs in offline demo mode (curated pathways) so the demo always works.
ANTHROPIC_API_KEY=

# Optional: swap the model. Default is claude-opus-4-8.
# For a snappier live demo you can use claude-sonnet-4-6.
HERNEXT_MODEL=claude-opus-4-8

# Optional: effort level for the reasoning step (low | medium | high). Default medium.
HERNEXT_EFFORT=medium
